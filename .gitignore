# ============================================================
#  고객 데이터 절대 커밋 금지 (원칙 A.2#6 / E.2)
# ============================================================
# 원본 도면 (읽기전용, 파생물로만 재생성)
/raw/*
!/raw/.gitkeep
# 파생 산출물 (SVG/DXF/리포트 — run 폴더로 재현)
/artifacts/*
!/artifacts/.gitkeep
# 검수용 렌더 이미지. 발주처 도면을 그린 것이라 커밋하면 안 된다.
#   실제로 out/*.png 9장이 커밋돼 있었다(3층 벽, 참고도면 벽, 문 스윙).
#   artifacts/ 는 막아 뒀는데 out/ 은 빠뜨렸다. 렌더 스크립트는 이제 artifacts/ 로 쓴다.
/out/
# v0.1 추출 결과 (실 방이름 포함 → 고객 식별 가능)
/legacy/v0.1/output/
master_rooms.json
rooms.json
pressure.json
# wizard 가 생성하는 초안 (도구 산출물)
/profiles/_draft_*.yaml

# CAD/문서 바이너리 (fixture 합성 DXF 만 예외)
*.dwg
*.dxf
!tests/fixtures/synthetic/**/*.dxf
*.zip
*.pdf
*.docx
*.pptx

# ============================================================
#  비밀/환경
# ============================================================
.env
.env.*
!.env.example
*.pem
*.key

# ============================================================
#  Python
# ============================================================
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ============================================================
#  DB / Docker 로컬 볼륨
# ============================================================
pg_data/
neo4j_data/

# ============================================================
#  IDE / OS
# ============================================================
.vscode/
.idea/
.DS_Store
Thumbs.db
